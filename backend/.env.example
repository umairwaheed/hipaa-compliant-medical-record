# Copy to .env and set real secrets in any non-demo environment.
# NEVER commit a real .env — it contains keys that decrypt PHI.

# Signs JWT access tokens. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret-change-me

# Fernet key used to encrypt PHI columns at rest (§164.312(a)(2)(iv)).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WARNING: losing this key makes all encrypted PHI unrecoverable.
PHI_ENCRYPTION_KEY=

# HIPAA §164.312(a)(2)(iii) Automatic logoff — minutes of token validity.
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Comma-separated CORS origins for the SPA.
CORS_ORIGINS=http://localhost:5173

DATABASE_URL=sqlite:///./hipaa_demo.db
