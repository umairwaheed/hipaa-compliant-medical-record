# Production configuration. Copy to .env and supply real values.
# The app FAILS TO BOOT if the required secrets are missing or look like
# placeholders. NEVER commit a real .env — it contains keys that decrypt PHI.

# --- Required secrets (no defaults) ---
# JWT signing key. Generate: openssl rand -base64 48
SECRET_KEY=

# --- PHI key source ---
# KEY_PROVIDER=env   → use PHI_ENCRYPTION_KEY below.
# KEY_PROVIDER=vault → unwrap the DEK from HashiCorp Vault (transit) at boot;
#                      no plaintext PHI key is stored in this file. See
#                      KEY-MANAGEMENT.md.
KEY_PROVIDER=env

# Used only when KEY_PROVIDER=env. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WARNING: losing this key makes all encrypted PHI unrecoverable.
PHI_ENCRYPTION_KEY=

# Used only when KEY_PROVIDER=vault:
# VAULT_ADDR=https://<key-host>:8200
# VAULT_CACERT=/home/hipaa/vault-ca.pem
# VAULT_ROLE_ID=...
# VAULT_SECRET_ID=...
# VAULT_TRANSIT_KEY=hipaa-phi
# WRAPPED_PHI_DEK=vault:v1:...

# PostgreSQL only. SQLite is rejected.
DATABASE_URL=postgresql+psycopg://hipaa:CHANGE_ME@127.0.0.1:5432/hipaa

# --- Environment ---
ENVIRONMENT=production
# Comma-separated allowed SPA origins. No wildcard in production.
CORS_ORIGINS=https://your-domain.example

# --- Policy (optional; sane defaults shown) ---
ACCESS_TOKEN_EXPIRE_MINUTES=15
PREAUTH_TOKEN_EXPIRE_MINUTES=5
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
MIN_PASSWORD_LENGTH=12
MFA_ISSUER=HIPAA Medical Records
